# Configuración SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SCI Sistema" <no-reply@sci.local>

# Expiración de Tokens (en horas)
ACTIVATION_TOKEN_EXPIRY_HOURS=72
RECOVERY_TOKEN_EXPIRY_HOURS=24