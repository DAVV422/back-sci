# Sitios del SCI (EmergIA). Lo importa el Caddyfile que ya corre en el servidor; no toca
# ninguna ruta de los sitios que ya estaban.
#
# emerg-ia.com apunta directo al VPS (sin Cloudflare delante), así que Caddy obtiene y renueva
# el certificado con Let's Encrypt. Para eso los puertos 80 y 443 deben estar abiertos.

# Una copia del SCI: la web estática y su API. El argumento es el puerto local de esa API.
(sci_institucion) {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# API y canal en vivo (socket.io usa /socket.io/ aunque el espacio sea /notifications).
	handle /api/* {
		reverse_proxy 127.0.0.1:{args[0]}
	}
	handle /socket.io/* {
		reverse_proxy 127.0.0.1:{args[0]} {
			flush_interval -1
		}
	}

	# La web: una sola compilación para todas las instituciones (rutas relativas).
	handle {
		root * /srv/sci/web
		try_files {path} /index.html
		file_server
	}
}

demo.emerg-ia.com {
	import sci_institucion 3001
}

test.emerg-ia.com {
	import sci_institucion 3002
}

fru.emerg-ia.com {
	import sci_institucion 3003
}

# El dominio principal queda para la presentación del proyecto.
emerg-ia.com, www.emerg-ia.com {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	root * /srv/sci/landing
	try_files {path} /index.html
	file_server
}
