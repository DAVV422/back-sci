APP_NAME=backend_project
APP_PROD=false
APP_VERSION=0.0.3
PORT=3000

APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://localhost:8080,http://localhost:3000

DB_CONNECTION=postgres
DB_HOST=nest_db
DB_PORT=5432
DB_DATABASE=nest_db
DB_USERNAME=postgres
DB_PASSWORD=admin

HASH_SALT=10
JWT_AUTH=MiclaveSecreta
JWT_RECOVERY=MISegundaClaVeSecreta
JWT_REFRESH_EXPIRATION=7d
# Duración del token de acceso (la web lo renueva sola con el refresh token). Por defecto 8h.
JWT_EXPIRATION=1h
# Opcional: clave propia para los refresh tokens (si no, se usa JWT_AUTH). En producción, 32+ caracteres.
JWT_REFRESH_SECRET=

# Seeder de producción (usuario admin inicial)
ADMIN_EMAIL=admin@sci.local
ADMIN_PASSWORD=change_me_on_production
ADMIN_NAME=Administrador
ADMIN_LAST_NAME=Sistema

# Configuración SMTP (Envío de Correos)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_password_smtp
SMTP_FROM="Sistema SCI" <no-reply@sci.local>

# Expiración de Tokens (en horas)
ACTIVATION_TOKEN_EXPIRY_HOURS=72
# Vigencia del enlace para restablecer la contraseña (horas enteras; un solo uso)
RECOVERY_TOKEN_EXPIRY_HOURS=1

# Activación de Usuarios
# true: requiere activación por correo electrónico
# false: los nuevos usuarios quedan activos de inmediato (por defecto false si no se define)
REQUIRE_EMAIL_ACTIVATION=false

# Rate limiting por IP y minuto (opcionales). Sin valor: 300 global y 5-10 en autenticación (SPEC-F1-005).
# THROTTLE_LIMIT=300
# THROTTLE_AUTH_LIMIT=5

# Zona horaria de la institución (IANA). Todo se guarda en UTC; esta zona se usa para mostrar
# fechas y agrupar reportes. Bolivia: America/La_Paz (UTC-4).
APP_TIMEZONE=America/La_Paz

# Alinea la tabla charge con el catálogo del manual SCI al arrancar (false para desactivarlo)
CHARGE_CATALOG_SYNC=true

# Almacenamiento de archivos (fotos de perfil, croquis del 201, notas de voz).
# Hoy en disco; el código usa claves (uploads/croquis/..., audios/<usuario>/<emergencia>/...),
# el mismo contrato que un bucket S3. Raíz por defecto: <carpeta del backend>/data
STORAGE_LOCAL_ROOT=

# --- Producción (APP_PROD=true) ---
# La API no arranca si JWT_AUTH tiene menos de 32 caracteres o es el de ejemplo, si ADMIN_PASSWORD
# es débil o si CORS_ORIGINS/FRONTEND_URL no lista los dominios del front.
# Swagger (/docs) queda apagado en producción salvo SWAGGER_ENABLED=true.
SWAGGER_ENABLED=false
# Cantidad de proxies delante (Nginx/Caddy): necesario para que el límite de peticiones sea por IP real.
TRUST_PROXY=
# TLS hacia Postgres: false (mismo servidor), true (verifica el certificado) o no-verify.
# Sin definir: no-verify en producción, sin TLS en desarrollo (comportamiento anterior).
DB_SSL=
